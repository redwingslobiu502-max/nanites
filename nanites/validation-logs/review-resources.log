allprojects { group = 'dev.nanites'; version = '0.2.0'; repositories { mavenCentral() } }
subprojects { tasks.withType(JavaCompile).configureEach { options.encoding = 'UTF-8' }; tasks.withType(AbstractArchiveTask).configureEach { preserveFileTimestamps = false; reproducibleFileOrder = true } }
pluginManagement { repositories { maven { url = 'https://maven.minecraftforge.net' }; maven { url = 'https://maven.fabricmc.net' }; gradlePluginPortal() } }
rootProject.name = 'nanites'
include 'core', 'shared-game'
def loader = providers.gradleProperty('loader').getOrElse('forge')
if (!(loader in ['forge','fabric'])) throw new GradleException('Use -Ploader=forge or fabric')
include loader
